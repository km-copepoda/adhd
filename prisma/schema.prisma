generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  CHILD
}

enum Side {
  DARK
  LIGHT
}

enum Category {
  STUDY
  STAMINA
  LIFE
}

enum QuestStatus {
  PENDING
  REPORTED
  APPROVED
  REJECTED
  SKIPPED
  SKIP_REPORTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

model Family {
  id              String               @id @default(cuid())
  code            String               @unique
  createdAt       DateTime             @default(now())
  autoApproveTime String               @default("24:00")
  users           User[]
  tasks           TaskTemplate[]
  monsterThemes   FamilyMonsterTheme[]
}

model User {
  id                     String             @id @default(cuid())
  supabaseId             String             @unique
  role                   Role
  name                   String?
  side                   Side?
  /// 現在有効化しているモンスターテーマセットの id (@/lib/monsterThemes/index の MONSTER_THEMES キー)。
  /// 未設定ユーザーは "dark" 扱い（バックフィル: side=LIGHT → "light"、それ以外 → "dark"）。
  monsterSetId           String             @default("dark")
  /// 進化演出中など、次回反映待ちのテーマ切り替え予約 id。null の間は monsterSetId をそのまま使う。
  pendingMonsterSetId    String?
  monsterName            String?
  childCode              String?
  evolutionStage         Int                @default(0)
  evolutionPath          String             @default("")
  collectedPaths         String             @default("[]")
  monsterLevels          String             @default("{}")
  studyPt                Int                @default(0)
  staminaPt              Int                @default(0)
  lifePt                 Int                @default(0)
  minTasksForStreak      Int                @default(1)
  reportDeadlineTime     String?
  checkinDeadlineTime    String?
  questTimeNotifyEnabled Boolean            @default(true)
  rebirthPending         Boolean            @default(false)
  rebirthEggBonus        String?
  usedEggBonuses         String             @default("[]")
  familyId               String?
  family                 Family?            @relation(fields: [familyId], references: [id])
  quests                 QuestInstance[]
  streak                 Streak?
  taskStreaks            TaskStreak[]
  assignedTasks          TaskTemplate[]     @relation("AssignedTasks")
  pushSubscriptions      PushSubscription[]
  badges                 UserBadge[]
  gatheringMember        GatheringMember?
  bulletinLogs           BulletinLog[]
  sentStamps             Stamp[]
  questDeclarations      QuestDeclaration[]
  treasureItems          TreasureItem[]
  treasureLogs           TreasureLog[]
  /// 宝箱抽選の天井 (pity) カウンタ。親ごほうび不当選で +1、当選 or pity 発動でリセット。
  /// PITY_THRESHOLD (10) に到達した次の引きは強制 HIT に書き換える。
  /// 決定: 2026-06-02 撤廃 → 2026-06-24 復活 (decisions.md 参照)
  treasurePityCount      Int                @default(0)
  collectionItems        UserCollectionItem[]
  checkinLogs            CheckinLog[]
  subscription           Subscription?
  createdAt              DateTime           @default(now())

  @@unique([familyId, childCode])
  @@index([familyId])
}

/// 課金プラン管理。無料 / プレミアムの2種類。レコードが無ければ FREE 扱い。
/// - userId は User(親) の id を指す (課金主体は親アカウント)。
/// - currentPeriodEnd が過去 → 実効プランは FREE (getUserPlan で判定)。
/// - canceledAt は「解約申請済み」フラグ。currentPeriodEnd まではアクティブ扱い。
/// - platform / externalId は将来的な Stripe / StoreKit / Google Play Billing 連携用。
model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan @default(FREE)
  platform         String?
  externalId       String?
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

/// 家族が有効化した／解禁済みのモンスターテーマセット記録（Issue #111）。
/// 有料テーマ（例: buddha）の購入・付与履歴を家族単位で管理する。
/// 旧 ChildMonsterTheme（子供単位）からの移行先。兄弟間でテーマの所持を共有するため、
/// familyId + themeId で一意とする。dark/light は無料のため付与レコードが無くても
/// 常に選択可能（選択可否の判定は @/lib/monsterThemes/index の isFree と組み合わせて行う）。
model FamilyMonsterTheme {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  themeId      String
  activatedAt  DateTime @default(now())
  /// 有効化理由（例: "purchase", "default", "manual"）。将来の付与経路追加に備えた自由文字列。
  grantReason  String

  @@unique([familyId, themeId])
  @@index([familyId])
}

model TaskTemplate {
  id                String             @id @default(cuid())
  title             String
  emoji             String             @default("⚔️")
  category          Category
  repeatDays        Int[]
  isTemporary       Boolean            @default(false)
  targetDate        DateTime?          @db.Date
  createdBy         Role               @default(PARENT)
  isActive          Boolean            @default(true)
  requestedDate     DateTime?          @db.Date
  familyId          String
  family            Family             @relation(fields: [familyId], references: [id])
  photoBonus        Boolean            @default(false)
  originalCreatedBy Role               @default(PARENT)
  carryOver         Boolean            @default(false)
  /// 親が「一時停止」ボタンを押した時刻。non-null の間は子供画面に表示されず、
  /// ensureTodayQuests でも QuestInstance を新規生成しない（既存の PENDING/REPORTED/SKIP_REPORTED は残るが表示上フィルタされる）。
  /// 再開時に null に戻す。テンプレート自体は削除ではないため repeatDays / targetDate は保持される。
  /// 用途: 夏休み中に通常タスクを止めつつ夏休み用タスクだけ表示する等。
  pausedAt          DateTime?
  /// 過去の停止期間 (JSON 配列)。各要素: `{ start: ISO文字列, end: ISO文字列 }`。
  /// 現在停止中の期間は pausedAt にのみ存在し、再開時にここへ push されて pausedAt は null に戻る。
  /// 親画面の「N回未完了」バッジ計算で停止期間中の予定日を除外し、
  /// 「解除後にカウントが停止日数ぶん暴騰する」問題を防ぐために使う。
  pauseIntervals    Json               @default("[]")
  assignedChildId   String?
  assignedChild     User?              @relation("AssignedTasks", fields: [assignedChildId], references: [id])
  quests            QuestInstance[]
  taskStreaks       TaskStreak[]
  declarations      QuestDeclaration[]
  createdAt         DateTime           @default(now())

  @@index([familyId])
  @@index([assignedChildId])
}

model QuestInstance {
  id                  String       @id @default(cuid())
  date                DateTime     @db.Date
  status              QuestStatus  @default(PENDING)
  comment             String?
  photoUrl            String?
  deadlineBonusEarned Boolean      @default(false)
  rejectionReason     String?
  approvalStamp       String?
  snapshotTitle       String
  snapshotEmoji       String
  snapshotCategory    Category
  templateId          String
  template            TaskTemplate @relation(fields: [templateId], references: [id])
  childId             String
  child               User         @relation(fields: [childId], references: [id])
  reportedAt          DateTime?
  approvedAt          DateTime?
  createdAt           DateTime     @default(now())

  @@unique([templateId, childId, date])
  @@index([childId])
  @@index([childId, date])
  @@index([childId, status])
}

model Streak {
  id                    String    @id @default(cuid())
  childId               String    @unique
  child                 User      @relation(fields: [childId], references: [id])
  currentStreak         Int       @default(0)
  bestStreak            Int       @default(0)
  lastAchievedDate      DateTime? @db.Date
  loginCurrentStreak    Int       @default(0)
  loginBestStreak       Int       @default(0)
  lastLoginDate         DateTime? @db.Date
  checkinCurrentStreak  Int       @default(0)
  checkinBestStreak     Int       @default(0)
  lastCheckinDate       DateTime? @db.Date
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// チェックインカレンダー: 子供が締切時刻までにクエスト画面を開いた／開かなかったを日別に記録する。
/// 親が `checkinDeadlineTime` を設定したときのみ有効。1日1レコード。
/// 当日一度も開かなかった場合はレコードなし → カレンダー表示時にクライアントが失敗として扱う。
model CheckinLog {
  id          String   @id @default(cuid())
  childId     String
  child       User     @relation(fields: [childId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  success     Boolean
  checkedInAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([childId, date])
  @@index([childId])
}

model TaskStreak {
  id               String       @id @default(cuid())
  taskId           String
  task             TaskTemplate @relation(fields: [taskId], references: [id])
  childId          String
  child            User         @relation(fields: [childId], references: [id])
  currentStreak    Int          @default(0)
  bestStreak       Int          @default(0)
  lastAchievedDate DateTime?    @db.Date
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([taskId, childId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum GatheringLocationType {
  PARK // 公園 max10
  COMMUNITY_CENTER // 児童館 max30
  SCHOOL // 校庭 max50
}

enum BulletinLogType {
  TASK_STARTED
  TASK_PROGRESS_25
  TASK_PROGRESS_50
  TASK_PROGRESS_75
  TASK_COMPLETE
  BADGE_UNLOCKED
  STREAK_TITLE
  MONSTER_EVOLVED
  MONSTER_REBORN
  STAMP_SENT
  COLLECTION_ITEM_OBTAINED
}

model GatheringGroup {
  id         String                @id @default(cuid())
  location   GatheringLocationType
  secretWord String
  members    GatheringMember[]
  logs       BulletinLog[]
  stamps     Stamp[]
  createdAt  DateTime              @default(now())

  @@unique([location, secretWord])
}

/// グループ参加中の子供が「エールを送る」ために 1日1回 INSERT するレコード。
/// 受信ログは別テーブルに残さない（Realtime + Push でその場限りの通知）。
model Stamp {
  id        String         @id @default(cuid())
  groupId   String
  group     GatheringGroup @relation(fields: [groupId], references: [id])
  senderId  String
  sender    User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  createdAt DateTime       @default(now())

  /// 1日1回制約（同じ送信者が同日複数回押せない）
  @@unique([senderId, date])
  @@index([groupId, createdAt])
}

model GatheringMember {
  id       String         @id @default(cuid())
  groupId  String
  group    GatheringGroup @relation(fields: [groupId], references: [id])
  childId  String         @unique
  child    User           @relation(fields: [childId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())
}

/// 「今日やる宣言」のレコード。
/// 3日以上アイドル状態のタスクに対して子供が当日内に宣言ボタンを押した事実だけを記録する。
/// 宣言した日のうちに APPROVED まで持っていけば +1XP のボーナスが付与される（src/lib/approve.ts）。
/// ペナルティは無い（押さなかった日も、押したけど未完了の日も、何も起こらない）。
model QuestDeclaration {
  id         String       @id @default(cuid())
  templateId String
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  childId    String
  child      User         @relation(fields: [childId], references: [id], onDelete: Cascade)
  date       DateTime     @db.Date
  createdAt  DateTime     @default(now())

  @@unique([templateId, childId, date])
  @@index([childId, date])
}

/// 宝箱プールのごほうびアイテム。子供ごとに親が設定する。
/// title + rarity のみ。レア度は COMMON / UNCOMMON / RARE の3段階。
model TreasureItem {
  id        String         @id @default(cuid())
  childId   String
  child     User           @relation(fields: [childId], references: [id], onDelete: Cascade)
  title     String
  rarity    TreasureRarity
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  logs      TreasureLog[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([childId])
}

/// 宝箱1個 = 1レコード。LOCKED → UNLOCKED → OPENED の状態遷移で全ライフサイクルを管理。
/// 報告時に LOCKED 生成、承認で UNLOCKED、子供が開封で OPENED + 抽選結果 (itemId) 確定。
/// 自動承認時は LOCKED をスキップして直接 UNLOCKED で生成。
/// 差し戻しで minTasks を割った場合は CANCELLED。
model TreasureLog {
  id               String          @id @default(cuid())
  childId          String
  child            User            @relation(fields: [childId], references: [id], onDelete: Cascade)
  date             DateTime        @db.Date
  trigger          TreasureTrigger
  boosted          Boolean         @default(false)
  status           TreasureStatus  @default(LOCKED)
  itemId           String?
  item             TreasureItem?   @relation(fields: [itemId], references: [id])
  /// 親ごほうび不当選時に付与されたコレクションアイテムの id (例: "summer-01")。
  /// マスターは src/lib/collectionItems.ts (DB FK 無し)。当選 / 未開封なら null。
  collectionItemId String?
  /// 親が「実物のごほうびを子供に渡したか」を記録するフラグ。
  /// 子画面には露出させず、親のみが /app/parent/treasures/pending で
  /// チェックできる（水掛け論の防衛用、2026-05-28 廃止を 2026-05-31 で復活）。
  /// 親ごほうび当選 (itemId が non-null) の TreasureLog のみ意味を持つ。
  /// コレクション獲得 (itemId=null) は実物受け渡しが無いので無関係。
  fulfilled        Boolean         @default(false)
  openedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([childId, status])
  @@index([childId, date])
}

enum TreasureRarity {
  COMMON
  UNCOMMON
  RARE
}

enum TreasureTrigger {
  STREAK
  ALL_COMPLETE
  PROXY
}

enum TreasureStatus {
  LOCKED
  UNLOCKED
  OPENED
  CANCELLED
}

/// 子供が宝箱のハズレ枠から獲得した季節コレクションアイテムの所持記録。
/// マスターデータ (アイテム定義) は src/lib/collectionItems.ts の定数。DB には所持実績のみ保存。
/// 同じ itemId を複数回引いた場合は count を increment し、lastAcquiredAt を更新する。
model UserCollectionItem {
  id              String   @id @default(cuid())
  childId         String
  child           User     @relation(fields: [childId], references: [id], onDelete: Cascade)
  itemId          String
  season          String
  count           Int      @default(1)
  firstAcquiredAt DateTime @default(now())
  lastAcquiredAt  DateTime @default(now())

  @@unique([childId, itemId])
  @@index([childId])
  @@index([childId, season])
}

model BulletinLog {
  id        String          @id @default(cuid())
  groupId   String
  group     GatheringGroup  @relation(fields: [groupId], references: [id])
  childId   String
  child     User            @relation(fields: [childId], references: [id], onDelete: Cascade)
  type      BulletinLogType
  message   String
  /// 同 type 内のサブ識別子（バッジ名・称号・進化先モンスター名・卵タイプなど）。
  /// 同日に別バッジを複数解除した場合の重複回避に使う。TASK_* は "" 固定で従来通り冪等。
  key       String          @default("")
  date      DateTime        @db.Date
  createdAt DateTime        @default(now())

  @@unique([groupId, childId, type, date, key])
  @@index([groupId, createdAt])
}
