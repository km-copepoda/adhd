generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  CHILD
}

enum Side {
  DARK
  LIGHT
}

enum Category {
  STUDY
  STAMINA
  LIFE
}

enum QuestStatus {
  PENDING
  REPORTED
  APPROVED
  REJECTED
  SKIPPED
  SKIP_REPORTED
}

model Family {
  id                 String         @id @default(cuid())
  code               String         @unique
  createdAt          DateTime       @default(now())
  autoApproveTime    String         @default("24:00")
  users              User[]
  tasks              TaskTemplate[]
}

model User {
  id          String          @id @default(cuid())
  supabaseId  String          @unique
  role        Role
  name        String?
  side        Side?
  monsterName String?
  childCode      String?
  evolutionStage  Int    @default(0)
  evolutionPath   String @default("")
  collectedPaths  String @default("[]")
  monsterLevels   String @default("{}")
  studyPt        Int             @default(0)
  staminaPt      Int             @default(0)
  lifePt         Int             @default(0)
  minTasksForStreak   Int             @default(1)
  reportDeadlineTime  String?
  rebirthPending      Boolean         @default(false)
  rebirthEggBonus     String?
  usedEggBonuses      String          @default("[]")
  familyId    String?
  family      Family?         @relation(fields: [familyId], references: [id])
  quests              QuestInstance[]
  streak              Streak?
  taskStreaks         TaskStreak[]
  assignedTasks       TaskTemplate[]     @relation("AssignedTasks")
  pushSubscriptions   PushSubscription[]
  badges              UserBadge[]
  createdAt           DateTime           @default(now())

  @@unique([familyId, childCode])
  @@index([familyId])
}

model TaskTemplate {
  id               String          @id @default(cuid())
  title            String
  emoji            String          @default("⚔️")
  category         Category
  repeatDays       Int[]
  isTemporary      Boolean         @default(false)
  targetDate       DateTime?       @db.Date
  createdBy        Role            @default(PARENT)
  isActive         Boolean         @default(true)
  requestedDate    DateTime?       @db.Date
  familyId         String
  family           Family          @relation(fields: [familyId], references: [id])
  photoBonus          Boolean         @default(false)
  originalCreatedBy   Role            @default(PARENT)
  assignedChildId  String?
  assignedChild    User?           @relation("AssignedTasks", fields: [assignedChildId], references: [id])
  quests           QuestInstance[]
  taskStreaks      TaskStreak[]
  createdAt        DateTime        @default(now())

  @@index([familyId])
  @@index([assignedChildId])
}

model QuestInstance {
  id               String       @id @default(cuid())
  date             DateTime     @db.Date
  status           QuestStatus  @default(PENDING)
  comment          String?
  photoUrl            String?
  deadlineBonusEarned Boolean   @default(false)
  rejectionReason     String?
  approvalStamp       String?
  snapshotTitle    String?
  snapshotEmoji    String?
  snapshotCategory Category?
  templateId       String
  template   TaskTemplate @relation(fields: [templateId], references: [id])
  childId    String
  child      User         @relation(fields: [childId], references: [id])
  reportedAt DateTime?
  approvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([templateId, childId, date])
  @@index([childId])
  @@index([childId, date])
  @@index([childId, status])
}

model Streak {
  id               String    @id @default(cuid())
  childId          String    @unique
  child            User      @relation(fields: [childId], references: [id])
  currentStreak    Int       @default(0)
  bestStreak       Int       @default(0)
  lastAchievedDate DateTime? @db.Date
  loginCurrentStreak Int     @default(0)
  loginBestStreak    Int     @default(0)
  lastLoginDate      DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TaskStreak {
  id               String       @id @default(cuid())
  taskId           String
  task             TaskTemplate @relation(fields: [taskId], references: [id])
  childId          String
  child            User         @relation(fields: [childId], references: [id])
  currentStreak    Int          @default(0)
  bestStreak       Int          @default(0)
  lastAchievedDate DateTime?    @db.Date
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([taskId, childId])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
